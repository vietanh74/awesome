{
  "name": "awesome",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://vietanh74.github.io/awesome",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist",
    "types-check": "vue-tsc --noEmit",
    "lint:script": "oxlint --quiet src",
    "lint:format": "oxfmt src",
    "lint": "pnpm lint:script && pnpm lint:format --check",
    "lintfix": "pnpm lint:script --fix && pnpm lint:format --write",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vueuse/core": "^14.4.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.19.0",
    "date-chinese": "^2.1.4",
    "date-fns": "^4.4.0",
    "gh-pages": "^6.3.0",
    "lodash-es": "^4.18.1",
    "nanoid": "^6.0.1",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-svg-loader": "^5.1.1",
    "vue-tsc": "^3.3.9"
  },
  "volta": {
    "node": "24.19.0"
  },
  "lint-staged": {
    "*.{js,cjs,ts,vue}": [
      "oxlint --quiet"
    ],
    "*.{js,cjs,ts,vue,css,scss}": [
      "oxfmt --check"
    ]
  }
}
