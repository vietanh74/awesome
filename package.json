{
  "name": "awesome",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://vietanh74.github.io/awesome",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "types-check": "vue-tsc --noEmit",
    "lint:partOfScript": "eslint -c eslint.config.mjs --quiet",
    "lint:script": "npm run lint:partOfScript --",
    "lint:partOfPrettier": "prettier --ignore-path .gitignore",
    "lint:prettier": "npm run lint:partOfPrettier -- \"src/**/*+(js|cjs|ts|vue|scss)\"",
    "lint:partOfStyle": "stylelint --allow-empty-input -i .gitignore -i .stylelintignore",
    "lint:style": "npm run lint:partOfStyle -- src/**/*.{css,scss}",
    "lint": "npm run lint:style && npm run lint:prettier -- --check && npm run lint:script",
    "lintfix": "npm run lint:style -- --fix && npm run lint:prettier -- --write && npm run lint:script -- --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@vueuse/core": "^14.4.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.19.0",
    "date-chinese": "^2.1.4",
    "date-fns": "^4.4.0",
    "gh-pages": "^6.3.0",
    "lodash-es": "^4.18.1",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-svg-loader": "^5.1.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  },
  "volta": {
    "node": "24.19.0"
  },
  "lint-staged": {
    "*.{js,cjs,ts,vue}": [
      "npm run lint:partOfScript"
    ],
    "*.{js,cjs,ts,vue,css,scss}": [
      "npm run lint:partOfPrettier -- --check"
    ],
    "*.{css,scss}": [
      "npm run lint:partOfStyle"
    ]
  }
}
